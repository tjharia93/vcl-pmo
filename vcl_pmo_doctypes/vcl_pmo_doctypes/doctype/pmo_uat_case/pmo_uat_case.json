{
  "doctype": "DocType",
  "name": "PMO UAT Case",
  "module": "VCL PMO Doctypes",
  "custom": 0,
  "autoname": "field:uat_case_id",
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1,
      "cancel": 1,
      "delete": 1
    },
    {
      "role": "PMO User",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ],
  "fields": [
    {
      "fieldname": "uat_case_id",
      "label": "UAT Case ID",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1
    },
    {
      "fieldname": "project",
      "label": "Project",
      "fieldtype": "Link",
      "options": "PMO Project",
      "reqd": 1
    },
    {
      "fieldname": "requirement",
      "label": "Requirement",
      "fieldtype": "Link",
      "options": "PMO Requirement"
    },
    {
      "fieldname": "bucket",
      "label": "Bucket",
      "fieldtype": "Data",
      "description": "Display label for grouping cases under a parent (Shift / Task / Plan / Push). Auto-filled when created from a Shift or Plan."
    },
    {
      "fieldname": "linked_shift",
      "label": "Linked Shift",
      "fieldtype": "Link",
      "options": "PMO Shift"
    },
    {
      "fieldname": "linked_task",
      "label": "Linked Task",
      "fieldtype": "Link",
      "options": "PMO Task"
    },
    {
      "fieldname": "linked_plan",
      "label": "Linked Plan",
      "fieldtype": "Link",
      "options": "PMO Plan"
    },
    {
      "fieldname": "description",
      "label": "Description",
      "fieldtype": "Text",
      "reqd": 1
    },
    {
      "fieldname": "acceptance_criteria",
      "label": "Acceptance Criteria",
      "fieldtype": "Long Text"
    },
    {
      "fieldname": "latest_result",
      "label": "Latest Result",
      "fieldtype": "Select",
      "options": "Pass\nFail\nBlocked\nNot Yet Run",
      "read_only": 1,
      "default": "Not Yet Run"
    },
    {
      "fieldname": "latest_run_date",
      "label": "Latest Run Date",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "run_count",
      "label": "Run Count",
      "fieldtype": "Int",
      "read_only": 1,
      "default": 0
    }
  ]
}
