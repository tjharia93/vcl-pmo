{
  "doctype": "DocType",
  "name": "PMO OAT Check",
  "module": "VCL PMO Doctypes",
  "custom": 0,
  "autoname": "field:check_id",
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "delete": 1},
    {"role": "PMO User", "read": 1, "write": 1, "create": 1}
  ],
  "fields": [
    {"fieldname": "check_id", "label": "Check ID", "fieldtype": "Data", "reqd": 1, "unique": 1},
    {"fieldname": "project", "label": "Project", "fieldtype": "Link", "options": "PMO Project"},
    {"fieldname": "area", "label": "Area", "fieldtype": "Data", "reqd": 1},
    {"fieldname": "check", "label": "Check", "fieldtype": "Text", "reqd": 1},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Not Run\nPass\nFail\nBlocked", "default": "Not Run"},
    {"fieldname": "owner", "label": "Owner", "fieldtype": "Data"},
    {"fieldname": "last_run", "label": "Last Run", "fieldtype": "Datetime"},
    {"fieldname": "evidence", "label": "Evidence", "fieldtype": "Long Text"},
    {"fieldname": "notes", "label": "Notes", "fieldtype": "Long Text"}
  ]
}
