{
  "doctype": "DocType",
  "name": "PMO Sync Log",
  "module": "VCL PMO Doctypes",
  "custom": 0,
  "autoname": "format:PMO-SYNC-.#####",
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "delete": 1},
    {"role": "PMO User", "read": 1, "write": 1, "create": 1}
  ],
  "fields": [
    {"fieldname": "anchor", "label": "Anchor", "fieldtype": "Data", "reqd": 1},
    {"fieldname": "direction", "label": "Direction", "fieldtype": "Select", "options": "Frappe to Excel\nExcel to Frappe\nAgent to Frappe\nManual", "reqd": 1},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "ok\nstale\nerror\nblocked", "reqd": 1},
    {"fieldname": "project", "label": "Project", "fieldtype": "Link", "options": "PMO Project"},
    {"fieldname": "detail", "label": "Detail", "fieldtype": "Long Text"},
    {"fieldname": "ts", "label": "Timestamp", "fieldtype": "Datetime", "default": "Now"}
  ]
}
